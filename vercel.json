{
  "version": 2,
  "builds": [
    {
      "src": "api/*.mjs",
      "use": "@vercel/node"
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/analyze",
      "dest": "/api/analyze.mjs"
    },
    {
      "src": "/api/presets",
      "dest": "/api/presets.mjs"
    },
    {
      "src": "/api/health",
      "dest": "/api/health.mjs"
    },
    {
      "src": "/health",
      "dest": "/api/health.mjs"
    },
    {
      "src": "/",
      "dest": "/public/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "/public/$1"
    }
  ]
}
